# Entorno de ejecucion: development | test | production
NODE_ENV=development
PORT=4000

# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Driver de datos: memory (sin dependencias externas) | supabase (PostgreSQL)
DATA_DRIVER=memory

# Credenciales de Supabase, obligatorias cuando DATA_DRIVER=supabase.
# SUPABASE_URL tambien define de donde se descargan las claves publicas (JWKS)
# con las que se verifican los tokens de sesion firmados de forma asimetrica.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo para proyectos que aun firman con el secreto compartido HS256 heredado.
# Los proyectos migrados a JWT Signing Keys asimetricas no lo necesitan.
SUPABASE_JWT_SECRET=

# Correo de la unica cuenta con acceso a /api/admin/overview.
# Sin esta variable el panel de administracion queda cerrado para todos.
ADMIN_EMAIL=
