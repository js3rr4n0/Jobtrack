# Entorno de ejecucion: development | test | production
NODE_ENV=development
PORT=4000

# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Driver de datos: memory (sin dependencias externas) | supabase (PostgreSQL)
DATA_DRIVER=memory

# Credenciales de Supabase, obligatorias cuando DATA_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto HS256 con el que Supabase firma los JWT de sesion
SUPABASE_JWT_SECRET=
